{
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/assets.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "predev:vision": "node scripts/assets.mjs",
    "dev:vision": "vite --host 127.0.0.1 --port 5176 --strictPort --open /vision.html"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.7.4",
    "@types/three": "^0.169.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.1"
  }
}
